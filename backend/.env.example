# Copy to `.env` and adjust. `.env` is gitignored.
#
# Postgres.app trusts the local OS user, so there is no password here. For any
# other Postgres (Homebrew, Docker, hosted) the shape is:
#
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
DATABASE_URL="postgresql://dwihp2@localhost:5432/financial_tracking?schema=public"

PORT=3001
