// Prisma schema — https://pris.ly/d/prisma-schema
//
// The connection string is deliberately NOT in this file. Prisma 7 keeps it in
// `prisma7.config.ts`, which reads DATABASE_URL from `.env` (see
// `.env.example`). That keeps credentials out of a committed file.

generator client {
  // The legacy generator: emits plain JavaScript into node_modules/@prisma/client,
  // which is what this backend (plain ESM, no build step) needs.
  //
  // TODO (exercise — optional): if you ever move the backend to TypeScript,
  // swap this for the modern generator:
  //   provider               = "prisma-client"
  //   output                 = "../src/generated/prisma"
  //   generatedFileExtension = "ts"
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

